{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node build.mjs",
  "outputDirectory": "public",
  "rewrites": [
    {
      "comment": "image-slot.js busca o sidecar com ponto na frente; arquivos ocultos não são servidos de forma confiável, então o build publica sem o ponto e este rewrite liga os dois.",
      "source": "/.image-slots.state.json",
      "destination": "/image-slots.state.json"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
