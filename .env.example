# ── Banco de dados ────────────────────────────────────────────────────
# Qualquer PostgreSQL: Neon, Supabase, Vercel Postgres, RDS. É onde a
# conta do cliente é criada e onde o webhook a marca como paga.
#
# USE A URL DO POOLER, não a direta. Cada requisição concorrente da
# Vercel sobe uma instância da função, e cada uma abre a própria
# conexão — a URL direta esgota o banco no primeiro pico.
#   Neon      → o host com '-pooler' no nome
#   Supabase  → porta 6543 (Connection pooling), não a 5432
DATABASE_URL=postgres://usuario:senha@host-pooler.exemplo.com/pontoseven?sslmode=require

# As migrações rodam sozinhas na primeira consulta de cada instância.
# Só desligue se o esquema for gerido por outra ferramenta — aí rode
# `npm run db:migrate` no seu pipeline.
# DB_AUTO_MIGRATE=0

# Só para banco com certificado de CA própria (RDS antigo, túnel).
# Provedores gerenciados usam CA pública e não precisam disto.
# DATABASE_SSL=no-verify

# ── Stripe ────────────────────────────────────────────────────────────
# Dashboard → Developers → API keys. sk_test_… em desenvolvimento.
STRIPE_SECRET_KEY=sk_test_troque_isto

# Dashboard → Developers → Webhooks → (seu endpoint) → Signing secret.
# Em dev, `stripe listen` imprime um whsec_… próprio — use o dele.
STRIPE_WEBHOOK_SECRET=whsec_troque_isto

# Price IDs recorrentes mensais (Products → cada plano → Pricing).
# São os preços realmente cobrados: R$ 49,90 / 99,90 / 149,90 / 199,90
# por mês, para até 10/20/40/60 funcionários — mesmas funcionalidades
# em todos, o que muda é só o limite de funcionários. Enterprise não
# tem price: cai no fluxo comercial sem passar pela Stripe.
STRIPE_PRICE_10=price_troque_isto
STRIPE_PRICE_20=price_troque_isto
STRIPE_PRICE_40=price_troque_isto
STRIPE_PRICE_60=price_troque_isto

# ── Acesso à plataforma ───────────────────────────────────────────────
# Depois do login, a landing manda o cliente para a plataforma com um
# JWT HS256 assinado com este segredo, que os dois lados conhecem.
# Mínimo de 32 caracteres — abaixo disso o token não é emitido.
#   openssl rand -base64 48
PLATAFORMA_SEGREDO=troque_por_um_segredo_longo_e_aleatorio

# Para onde o cliente vai depois de entrar, e em que rota a plataforma
# recebe o token (?token=…). Sem PLATAFORMA_SEGREDO, o login manda para
# a raiz e a pessoa entra com a senha na própria plataforma.
PLATAFORMA_URL=https://seteponto.cloud
# PLATAFORMA_ENTRADA=/sso

# ── URLs de retorno ───────────────────────────────────────────────────
# Todas opcionais. Sem elas o endpoint usa a origem da própria
# requisição, o que já funciona em preview e produção.
# URL_BASE=https://seteponto.cloud
# URL_SUCESSO=https://seteponto.cloud/bem-vindo
# URL_CANCELAMENTO=https://seteponto.cloud/?checkout=cancelado
# URL_OBRIGADO_VENDAS=https://seteponto.cloud/obrigado-vendas

# ── Manutenção ────────────────────────────────────────────────────────
# Protege GET /api/manutencao, que o Vercel Cron chama de madrugada para
# limpar sessões vencidas e janelas de limite. Sem esta variável a rota
# responde 503 em vez de rodar aberta.
#   openssl rand -hex 32
# CRON_SECRET=troque_por_um_segredo_aleatorio

# ── CORS ──────────────────────────────────────────────────────────────
# Só necessário se a landing for servida de um domínio diferente da API.
# No deploy padrão ela é do mesmo projeto e chama /api/... relativo.
# ORIGENS_PERMITIDAS=https://seteponto.cloud,https://www.seteponto.cloud

# ── Testes ────────────────────────────────────────────────────────────
# Aponta o SDK da Stripe para outro host (stripe-mock, ou a Stripe falsa
# de tests/). Só é obedecido com chave sk_test_.
# STRIPE_API_BASE=http://127.0.0.1:12111
