# ── Stripe ────────────────────────────────────────────────────────────
# Dashboard → Developers → API keys. sk_test_… em desenvolvimento.
STRIPE_SECRET_KEY=sk_test_troque_isto

# Dashboard → Developers → Webhooks → (seu endpoint) → Signing secret.
# Em dev, `stripe listen` imprime um whsec_… próprio — use o dele.
STRIPE_WEBHOOK_SECRET=whsec_troque_isto

# Price IDs recorrentes mensais (Products → cada plano → Pricing).
# São os preços realmente cobrados: R$ 100/mês e R$ 200/mês.
STRIPE_PRICE_BASICO=price_troque_isto
STRIPE_PRICE_STANDARD=price_troque_isto

# ── URLs de retorno ───────────────────────────────────────────────────
# Todas opcionais. Sem elas o endpoint usa a origem da própria requisição,
# o que já funciona em preview e produção. Preencha para fixar destinos.
# URL_BASE=https://seteponto.cloud
# URL_SUCESSO=https://seteponto.cloud/bem-vindo
# URL_CANCELAMENTO=https://seteponto.cloud/?checkout=cancelado
# URL_OBRIGADO_VENDAS=https://seteponto.cloud/obrigado-vendas

# ── CORS ──────────────────────────────────────────────────────────────
# Só necessário se a landing for servida de um domínio diferente da API.
# No deploy padrão ela é do mesmo projeto e chama /api/... relativo.
# ORIGENS_PERMITIDAS=https://seteponto.cloud,https://www.seteponto.cloud
